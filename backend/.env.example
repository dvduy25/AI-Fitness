# =====================================================
# HƯỚNG DẪN: Copy file này thành .env và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env lên Git!
# =====================================================

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT Secret - Tạo bằng: node -e "require('crypto').randomBytes(64).toString('hex')|cat"
JWT_SECRET=<your_random_64_char_secret>

# Google Gemini API Key
GEMINI_API_KEY=<your_gemini_api_key>

# Server Port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Allowed Frontend Origins (ngăn CORS từ domain lạ)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# MoMo Payment Gateway
PAYMENT_SECRET_KEY=<your_payment_secret>
MOMO_PARTNER_CODE=<your_partner_code>
MOMO_ACCESS_KEY=<your_access_key>
MOMO_SECRET_KEY=<your_secret_key>

# MoMo URLs
MOMO_REDIRECT_URL=http://localhost:5173/profile
MOMO_IPN_URL=https://your-backend-domain.com/api/transactions/webhook/payment
